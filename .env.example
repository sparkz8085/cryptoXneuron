# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty for same-origin Vercel deployment.
CORS_ORIGINS=

# MongoDB connection URL used by the training pipeline.
# Never commit real credentials here; set the real value in your local .env or Render environment.
MONGO_DB_URL=mongodb+srv://<username>:<password>@cryptoxneuron.r8rgpyl.mongodb.net/?appName=cryptoXneuron
MONGO_DATABASE_NAME=cryptoxneuron
MONGO_CUSTOMER_COLLECTION_NAME=customers
MONGO_USER_COLLECTION_NAME=users

# Optional. Enables the protected /train route only when set in production.
TRAINING_API_KEY=

# Set to 1 to trust local model deserialization (enforces safe classes only).
MODEL_TRUSTED=1

# JWT/HMAC Session signing secret. Provide a long random string.
SESSION_SECRET_KEY=replace_with_a_long_random_secret

# Optional public base URL used to construct OAuth callback URLs.
APP_BASE_URL=

# Google OAuth2 credentials (Optional - enables real login redirection)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth2 credentials (Optional - enables real login redirection)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=


# Frontend payment QR image URLs (configure these in Vercel; do not commit private QR files)
# These must point to the payment QR images for the corresponding plan.
VITE_PROFESSIONAL_PAYMENT_QR_URL=
VITE_ENTERPRISE_PAYMENT_QR_URL=
